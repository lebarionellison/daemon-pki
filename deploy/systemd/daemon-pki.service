[Unit]
Description=Daemon PKI mTLS Certificate Authority API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daemon-pki
Group=daemon-pki
WorkingDirectory=/opt/daemon-pki
ExecStart=/opt/daemon-pki/daemon-pki-server

Restart=always
RestartSec=5

Environment=DAEMON_PKI_DATA_DIR=/var/lib/daemon-pki
Environment=DAEMON_PKI_BIND=127.0.0.1:8443

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/daemon-pki

[Install]
WantedBy=multi-user.target

